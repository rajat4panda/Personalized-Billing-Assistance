# Vidyut Sahaayam — shared config for BOTH services (web + whatsapp).
# Copy this file to  .env  and fill in the values, then:  docker compose up -d --build
#
# RULES
#  - Put each value ALONE on its line. A comment must be on its OWN line.
#  - NEVER commit the real .env (it holds the Crest key and WhatsApp token).
#    .gitignore / .dockerignore already exclude it; the key is injected at
#    runtime and never baked into the image.
#  - Leave the CREST_* values blank to run in DEMO mode (on-device answers).
#  - Leave WHATSAPP_TOKEN blank to run the webhook in DRY_RUN (prints sends).
#  - PORT is set per-service by docker-compose (web=8014, whatsapp=8020); do not set it here.

# ================= Crest (same agents the web app and WhatsApp both use) =================

# Base URL of your Crest instance.
#   Use the Crest BACKEND API port (8000), NOT the Vite dev UI on 3000 (3000 rejects
#   unknown hosts with HTTP 403 'add to server.allowedHosts').
#   Crest on THIS host       : http://host.docker.internal:8000   <-- NOT localhost!
#   Crest on ANOTHER machine : http://10.0.0.5:8000  or  https://crest.yourhost
#   (inside a container, localhost means the container itself -> 'connection refused')
CREST_BASE_URL=http://host.docker.internal:8000/

# Billing Assistant agent UUID (explain / forecast) — powers /api/run.
CREST_AGENT_ID=3eee35e0-72ac-4089-a93a-ebdedfc6d47a

# Smart Assist agent UUID (ask / savings / checkup / schemes / solar / grievance) — powers /api/assist.
CREST_ASSIST_AGENT_ID=c9c10ec6-cc8a-4c51-ae33-4ad8a08132ea

# OPTIONAL. Bill Reader agent UUID (import bill_reader_india.crest.json) — powers /api/read.
# Reads any Indian DISCOM bill (PDF/photo) that has no readable QR. Leave blank to keep
# today's behaviour (non-QR files fall back to the chooser).
CREST_READER_AGENT_ID=143b3ed0-e87a-40ec-a65f-aaccab8368ea

# Your Crest API key / token (keep private; do NOT commit).
CREST_API_KEY=crest_live_sk_Jq98h3LIPflfX30mXEf_ju3eFO7Q0SeVKGOQ2D5IdJsmJhXk7OhRtA

# Run API path templates — {agent_id} and {run_id} are substituted. Defaults match Crest.
CREST_RUN_PATH=/api/v1/agents/{agent_id}/runs
CREST_GET_PATH=/api/v1/agents/{agent_id}/runs/{run_id}

# Seconds to poll a run before giving up.
CREST_POLL_TIMEOUT=150

# How to send the key: bearer | x-api-key | both
CREST_AUTH_HEADER=bearer

# Set to 1 ONLY for a dev self-signed Crest cert. Keep 0 in production.
CREST_INSECURE_TLS=0

# ================= Web app hardening (optional) =================

# Max request body the proxy accepts (bytes). Default 16 MiB.
# MAX_BODY_BYTES=16777216

# Send a Content-Security-Policy header. Leave off until verified against your deploy.
# SECURITY_CSP=1

# ================= WhatsApp Cloud API (Meta) — only the whatsapp service uses these =================
# Create an app at developers.facebook.com, add the WhatsApp product, then:

# Permanent / system-user access token. Blank => webhook runs in DRY_RUN.
WHATSAPP_

# The sending number's phone_number_id (a long number).
WHATSAPP_PHONE_NUMBER_ID=1363352586867615

# Any string you choose; must match what you enter in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=vidyut-verify

# App secret (Settings -> Basic). When set, X-Hub-Signature-256 is enforced.
WHATSAPP_APP_SECRET=

# Graph API version.
GRAPH_API_VERSION=v19.0

# Force DRY_RUN (print sends instead of calling Graph) even with a token:
# WHATSAPP_DRY_RUN=1
