# Copy this file to  .env  (same folder as server.py) and fill in your values.
#   cp .env.example .env
# server.py auto-loads .env on startup. Values already set in your shell win over .env.
# On boot the server prints what it detected (BASE/AGENT/KEY) and LIVE vs DEMO.

CREST_BASE_URL=http://144.24.108.128:3000/
CREST_AGENT_ID=3eee35e0-72ac-4089-a93a-ebdedfc6d47a
CREST_API_KEY=crest_live_sk_OkKA8dC68DAl1WUpCVzwHfxKDlBkONtpF6VhCuF_LGVjmixNGltmRw

# Run API path templates. {agent_id} and {run_id} are substituted. Defaults match the Crest docs.
CREST_RUN_PATH=/api/v1/agents/{agent_id}/runs
CREST_GET_PATH=/api/v1/agents/{agent_id}/runs/{run_id}
CREST_POLL_TIMEOUT=150

# How to send the key: bearer | x-api-key | both
CREST_AUTH_HEADER=bearer

# Dev self-signed cert only — do NOT use in production.
CREST_INSECURE_TLS=0

PORT=8700
