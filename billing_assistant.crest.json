        {
          "id": "forecast",
          "type": "code_exec",
          "position": {
            "x": 320,
            "y": -150
          },
          "data": {
            "label": "Forecast next bill (deterministic)",
            "config": {
              "code": "import json\n\ndef main(state, input_data):\n    bill = state.get('bill') or {}\n    if isinstance(bill, str):\n        try: bill = json.loads(bill)\n        except Exception: bill = {}\n\n    # history: prefer stored memory, else the history passed in the bill\n    raw = state.get('consumption_history') or '[]'\n    try:\n        hist = json.loads(raw) if isinstance(raw, str) else (raw or [])\n    except Exception:\n        hist = []\n    if not hist:\n        hist = bill.get('history') or []\n\n    units = float(bill.get('units_consumed') or 0)\n    charges = bill.get('charges') or []\n    energy = sum(float(c.get('amount') or 0) for c in charges)\n    series = [float(m.get('units_consumed') or 0) for m in hist if m.get('units_consumed') is not None]\n    trailing = (sum(series[-3:]) / min(len(series), 3)) if series else units\n    mon = str(bill.get('billing_month') or '')[:3]\n    seasonal = next((float(m['units_consumed']) for m in hist\n                     if str(m.get('billing_month') or '')[:3] == mon), trailing)\n    next_units = round(0.6 * seasonal + 0.4 * trailing)\n    avg_rate = (energy / units) if units else 0\n    next_energy = next_units * avg_rate\n    duty = round(next_energy * (float(bill.get('electricity_duty') or 0) / energy)) if energy else 0\n    fixed = float(bill.get('fixed_charges') or 0) + float(bill.get('customer_charges') or 0)\n    next_total = round(next_energy + fixed + duty)\n    trend = round((units - trailing) / trailing * 100) if trailing else 0\n\n    return {\n        'next_units': next_units,\n        'next_total': next_total,\n        'trend_pct': trend,\n        'confidence': 'high' if len(series) >= 6 else 'medium' if len(series) >= 3 else 'low',\n        'basis': str(len(series)) + '-month history',\n    }\n",
              "timeout_seconds": 5,
              "max_output_bytes": 65536,
              "target_variable": "forecast",
              "policy_mode": "enforce",
              "policy_rules": {},
              "redact_replay": true,
              "redact_fields": []
            },
