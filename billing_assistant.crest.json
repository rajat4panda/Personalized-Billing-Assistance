          "data": {
            "label": "Add this bill to history",
            "config": {
              "code": "import json\n\ndef main(state, input_data):\n    bill = state.get('bill') or {}\n    if isinstance(bill, str):\n        try: bill = json.loads(bill)\n        except Exception: bill = {}\n    raw = state.get('consumption_history') or '[]'\n    try:\n        hist = json.loads(raw) if isinstance(raw, str) else (raw or [])\n    except Exception:\n        hist = []\n    if not hist:\n        hist = bill.get('history') or []\n    entry = {\n        'billing_month': bill.get('billing_month'),\n        'units_consumed': bill.get('units_consumed'),\n        'total_amount': bill.get('total_amount'),\n    }\n    hist = [h for h in hist if h.get('billing_month') != entry['billing_month']]\n    hist.append(entry)\n    hist = hist[-24:]\n    return json.dumps(hist)\n",
