          "data": {
            "label": "Ingest bill (OCR slots in here in prod)",
            "config": {
              "code": "import json\n\ndef main(state, input_data):\n    # Accepts the parsed bill from the run's input_payload.\n    # In production, a File Processor (OCR) node sits before this and writes `bill`;\n    # for API/JSON triggers the caller passes the already-parsed bill here.\n    inp = state.get('input') or {}\n    if not isinstance(inp, dict):\n        inp = {}\n    bill = inp.get('bill') or {}\n    if isinstance(bill, str):\n        try: bill = json.loads(bill)\n        except Exception: bill = {}\n    return bill\n",
              "timeout_seconds": 5,
              "max_output_bytes": 65536,
              "target_variable": "bill",
              "policy_mode": "enforce",
              "policy_rules": {},
